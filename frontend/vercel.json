{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://api.yurucamp.my.id/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/((?!sitemap\\.xml|robots\\.txt).*)"
            "destination": "/index.html"
        }
    ]
}